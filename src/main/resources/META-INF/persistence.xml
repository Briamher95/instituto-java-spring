<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="
                 https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!-- El nombre debe coincidir con el de Configuracion y con el del plugin en el pom.xml. -->
    <persistence-unit name="Instituto">

        <!-- Clases persistentes que DataNucleus debe administrar. -->
        <class>com.programacion2.instituto.dominio.Persona</class>
        <class>com.programacion2.instituto.dominio.Alumno</class>
        <class>com.programacion2.instituto.dominio.Profesor</class>
        <class>com.programacion2.instituto.dominio.Curso</class>
        <class>com.programacion2.instituto.dominio.Inscripcion</class>

        <!-- Ignora cualquier clase que no esté listada arriba. -->
        <exclude-unlisted-classes/>

        <properties>

            <property
                name="javax.jdo.option.ConnectionDriverName"
                value="com.mysql.cj.jdbc.Driver"/>

            <property
                name="javax.jdo.option.ConnectionURL"
                value="jdbc:mysql://localhost:3306/instituto"/>

            <property
                name="javax.jdo.option.ConnectionUserName"
                value="instituto"/>

            <property
                name="javax.jdo.option.ConnectionPassword"
                value="instituto_tp"/>

            <!-- Crea las tablas que falten al iniciar la aplicación. -->
            <property
                name="datanucleus.schema.autoCreateAll"
                value="true"/>

        </properties>

    </persistence-unit>

</persistence>
